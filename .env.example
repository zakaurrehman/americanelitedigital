# Copy to .env.local (development) or set in your host's environment settings (production).
# Never commit real values.

# Canonical origin used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://americanelitedigital.com

# ── Inquiry delivery: configure at least one channel for production ─────────────────────────
# Email via SMTP. americanelitedigital.com mail runs on Titan (MX mx1.titan.email): host smtp.titan.email,
# port 465 (SSL). For a "Hostinger Email" mailbox instead: smtp.hostinger.com, port 465.
SMTP_HOST=
SMTP_PORT=465
# "true" for port 465 (implicit TLS); "false" for 587 (STARTTLS). Defaults from the port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Where inquiries are sent, and the sender shown on the notification email.
CONTACT_TO_EMAIL=info@americanelitedigital.com
CONTACT_FROM_EMAIL="American Elite Digital <info@americanelitedigital.com>"

# Optional: also POST each inquiry as JSON to a CRM / automation webhook.
CONTACT_WEBHOOK_URL=
# Optional: if set, requests carry an x-aed-signature: sha256=<HMAC of the body> header.
CONTACT_WEBHOOK_SECRET=

# ── Preview only ────────────────────────────────────────────────────────────────────────────
# Shows the (unpublished) logo packages and /pricing/ without publishing them.
# Leave unset in production; publishing is controlled by PACKAGES_PUBLISHED in src/content/packages.ts.
SHOW_PACKAGES=
